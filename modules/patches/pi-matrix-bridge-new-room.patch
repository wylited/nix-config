+    /**
+     * `/new <title>` — create a fresh private room named <title> for a new
+     * session and invite the requester (the bot is the creator, so it is in
+     * the room from the start; `chatId` = roomId means the bridge answers
+     * there the moment the user writes). When PI_MATRIX_BRIDGE_SPACE_ID is
+     * set, the room is also added as a child of that space so sessions group
+     * under one "pi" space. The reply — with a matrix.to permalink — goes to
+     * the SOURCE room.
+     */
+    async handleNewRoom(sourceRoomId, requesterUserId, title) {
+        try {
+            const name = title || `pi session ${new Date().toISOString().slice(0, 10)}`;
+            // matrix-bot-sdk's createRoom resolves to the roomId STRING —
+            // destructuring { room_id } yields undefined (observed live).
+            const newRoomId = await this.client.createRoom({
+                name,
+                preset: "trusted_private_chat",
+                visibility: "private",
+                invite: [requesterUserId],
+            });
+            let suffix = "";
+            const spaceId = (process.env.PI_MATRIX_BRIDGE_SPACE_ID || "").trim();
+            if (spaceId) {
+                try {
+                    // m.space.child lives in the space, keyed by the child room.
+                    const via = this.botUserId.split(":")[1];
+                    await this.client.sendStateEvent(spaceId, "m.space.child", { via: [via] }, newRoomId);
+                    suffix = " (added to the pi space)";
+                }
+                catch (err) {
+                    // Grouping is a bonus — never fail the room over it.
+                    if (this.errorHandler) {
+                        this.errorHandler(new Error(`Failed to add ${newRoomId} to space ${spaceId}: ${err.message}`));
+                    }
+                }
+            }
+            await this.sendMessage(sourceRoomId, `🆕 Session room "${name}": https://matrix.to/#/${newRoomId}${suffix}`);
+        }
+        catch (err) {
+            await this.sendMessage(sourceRoomId, `❌ /new failed: ${err.message}`).catch(() => { });
+        }
+    }
     onMessage(handler) {
         this.messageHandler = handler;
     }
