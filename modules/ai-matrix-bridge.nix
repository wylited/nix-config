# modules/ai-matrix-bridge.nix — the warden pi agent, reachable over Matrix DMs.
#
# The end-goal of the ai stack (decision 2026-10-26): pi is the coding agent
# the user already drives; pi-matrix-bridge is its remote UI — DM
# @pi:matrix.wyli.tech from any Matrix client and you are talking to a
# headless pi session on warden. Native pi extension, NOT baibot.
#
# Shape of the thing, with the research that forced each choice:
#
#   * pi-matrix-bridge (rolznz, MIT) is npm-only — absent from nixpkgs at
#     the fleet pin (421eebf, checked). So it is built here: source pinned
#     to d4c33b4 (the 0.5.0 release + the follow-up fix to the installer
#     script — upstream tags nothing), package-lock via npmDepsHash, tsc
#     build, prod node_modules + dist into the store. pi loads it through
#     the documented settings.json `extensions` array (absolute paths are
#     supported; pi.dev "Settings → Resources"), so nothing runs
#     `pi install` and boot needs no network. Upgrades are a hash bump.
#
#   * E2EE needs @matrix-org/matrix-sdk-crypto-nodejs 0.4.0, the optional
#     peer matrix-bot-sdk 0.8.0 resolves: its npm postinstall *downloads*
#     a napi prebuilt from GitHub releases. The sandbox blocks that, so
#     `--ignore-scripts` skips it and the exact x86_64-gnu artifact is
#     fetchurl'd next to index.js — the package loader checks for a
#     sibling .node before anything else. This file is load-bearing, not
#     an enhancement: matrix-bot-sdk requires the crypto package at
#     import time, and without a loadable binding pi aborts the whole
#     extension ("Failed to load extension ... Cannot find module"),
#     refusing to start (verified by running pi 0.80.10 against a
#     binding-less copy of this exact tree).
#
#   * Upstream's headless recipe (scripts/install-systemd.sh at d4c33b4)
#     wraps pi in `script(1)`: pi selects "print" mode when stdin is not a
#     TTY and disposes the extension runtime at stdin EOF — a PTY is what
#     keeps an always-on bridge alive. It also sets
#     PI_MATRIX_BRIDGE_AUTO_CONNECT=1 (the extension is dormant without
#     it) and Restart=always + unlimited start rate so the `/shutdown` DM
#     command relaunches into a fresh session: the restart IS the new
#     session, no --continue/--resume.
#
#   * Bot account + token: the exact modules/matrix/watchdog.nix alert-bot
#     idiom — a root oneshot registers through the
#     `matrix-synapse-register_new_matrix_user` wrapper the synapse module
#     installs (it already carries the extraConfigFiles — registration
#     shared secret included — and the listener URL), with password +
#     token under /var/lib/matrix-secrets/ and `restartIfChanged = false`
#     so a switch transaction never waits on it (the exit-4 lesson). One
#     deliberate difference: a still-valid token short-circuits the unit
#     (whoami probe). The alert bot re-mints per run, but a fresh /login
#     device per boot would churn the bridge's E2EE device identity and
#     demand re-verification every time. The token is a DEDICATED device —
#     the bridge README is explicit that reusing an interactive client's
#     token corrupts the crypto store.
#
#   * The agent "profile" is fully declarative: agent dir =
#     /var/lib/pi-matrix-bridge (PI_CODING_AGENT_DIR). settings.json and
#     models.json are regenerated by ExecStartPre on every start — the
#     extension's store path moves with each rebuild — while everything
#     else in the dir is USER data the unit never touches: sessions/,
#     mcp.json, skills/, AGENTS.md, and the extension's own
#     .pi/matrix-bridge.json + crypto store (auth state lives there).
#     Extend the bot by dropping files into the dir; the two generated
#     files are module-owned, tweak those in Nix.
#
# Model auth: /etc/nix/ai-env (root:wheel 0640, KEY=VALUE — see
# modules/ai.nix) is fed to pi as an EnvironmentFile. models.json replaces
# the built-in `zai` provider (its baseUrl is the coding-plan endpoint)
# with the plain paas/v4 endpoint the aichat client on this fleet already
# uses with the same ZAI_API_KEY, interpolated at request time — so the
# key never lands in the agent dir or the store.
{ config, lib, pkgs, ... }:

let
  cfg = config.services.aiMatrixBridge;
  mstack = config.services.matrixStack;

  user = "pi-bridge";
  group = user;
  stateDir = "/var/lib/pi-matrix-bridge";
  workspaceDir = "${stateDir}/workspace";
  secretsDir = mstack.secrets.directory;
  passwordFile = "${secretsDir}/pi-bot-password";
  tokenEnvFile = "${secretsDir}/pi-bridge.env";

  # --- the extension package (see header) ------------------------------
  nativeCryptoLib = pkgs.fetchurl {
    url = "https://github.com/matrix-org/matrix-rust-sdk-crypto-nodejs/releases/download/v0.4.0/matrix-sdk-crypto.linux-x64-gnu.node";
    hash = "sha256-cHjU3ZhxKPea/RksT2IfZK3s435D8qh1bx0KnwNN5xg=";
  };

  bridgeExtension = pkgs.buildNpmPackage {
    pname = "pi-matrix-bridge";
    version = "0.5.0";

    src = pkgs.fetchFromGitHub {
      owner = "rolznz";
      repo = "pi-matrix-bridge";
      # Upstream publishes to npm without git tags; d4c33b4 == npm 0.5.0
      # plus the install-systemd.sh fix shipped right after it.
      rev = "d4c33b449a35522891892faeebd4fa85c2838b14";
      hash = "sha256-F78jzd5CoX0iKefos5eGvkSdqTMcHOYGnERgeyTHN54=";
    };

    npmDepsHash = "sha256-bW1F427UV3UinTMSxTKGLvqoCcyWWbgiXclJQRagn80=";

    # The only install script in the tree that matters is the crypto
    # package's download-lib.js (network fetch of the prebuilt above).
    # Nothing else needs scripts, so skip them all.
    npmFlags = [ "--ignore-scripts" ];

    buildPhase = ''
      runHook preBuild
      npm run build
      runHook postBuild
    '';
    # Two patches onto the tsc OUTPUT, not the TS sources: both are anchored
    # to the dist files this exact pinned rev deterministically compiles, and
    # keep upstream's tree untouched for clean version bumps. Applied in
    # order — pi-matrix-bridge-ui.patch's context lines include the /new
    # hunk's output. Rebase both when rev/npmDepsHash move.
    #   1. `/new <title>` — trusted users spawn a fresh session room (bot
    #      creates it, invites them, matrix.to permalink; SPACE_ID nests it
    #      in a space).
    #   2. Matrix-side UI: DM passthrough for pi-native slash commands
    #      (/model /compact /thinking /name; unknown → friendly list, never
    #      leaked to the model), `!<cmd>` direct shell exec (no model turn),
    #      and a debounced live room-topic status line (model · ctx · cwd).
    postBuild = ''
      ${pkgs.patch}/bin/patch -p1 < ${./patches/pi-matrix-bridge-new-room.patch}
      ${pkgs.patch}/bin/patch -p1 < ${./patches/pi-matrix-bridge-ui.patch}
    '';

    installPhase = ''
      runHook preInstall
      # Fresh prod install in a scratch dir (not `npm prune` on the build
      # tree: prune leaves extraneous dev packages behind, verified
      # against npm 11). Peers stay: matrix-bot-sdk's barrel eagerly
      # requires its appservice stack (express, morgan, ...), and the
      # auto-installed @earendil-works peers are what `pi install`
      # ships upstream — unused here (the extension imports pi's runtime
      # only as TYPES, compiled away by tsc), but they cost little next
      # to being wrong. `npm ci` never consults the registry: against
      # the pinned offline cache this is the lockfile's prod tree,
      # exactly.
      mindir=$(mktemp -d)
      cp package.json package-lock.json "$mindir"/
      (cd "$mindir" && npm ci --omit=dev --ignore-scripts --no-audit --no-fund)
      mkdir -p $out/share/pi-matrix-bridge
      cp -r package.json dist "$mindir"/node_modules $out/share/pi-matrix-bridge/
      # Runtime crypto binding (see nativeCryptoLib). The install above
      # must keep matrix-bot-sdk's optional dep — assert rather than hope.
      test -d $out/share/pi-matrix-bridge/node_modules/@matrix-org/matrix-sdk-crypto-nodejs \
        || { echo "matrix-sdk-crypto-nodejs missing from minimal install" >&2; exit 1; }
      cp ${nativeCryptoLib} \
        $out/share/pi-matrix-bridge/node_modules/@matrix-org/matrix-sdk-crypto-nodejs/matrix-sdk-crypto.linux-x64-gnu.node
      runHook postInstall
    '';

    meta = {
      description = "Matrix bridge extension for the pi coding agent";
      homepage = "https://github.com/rolznz/pi-matrix-bridge";
      license = lib.licenses.mit;
      platforms = [ "x86_64-linux" ];
    };
  };

  # pi loads this via settings.json `extensions` (absolute file path);
  # `matrix-bot-sdk` imports from dist/index.js resolve against the
  # node_modules shipped in the same store path.
  extensionEntry = "${bridgeExtension}/share/pi-matrix-bridge/dist/index.js";

  settingsJson = pkgs.writers.writeJSON "settings.json" {
    "$schema" = "https://pi.dev/schemas/settings.schema.json";
    defaultProvider = "zai";
    defaultModel = cfg.model;
    extensions = [ extensionEntry ];
    # The bot owns its workspace; there is nothing to trust in it, and
    # `ask` would hang a headless session on a prompt.
    defaultProjectTrust = "never";
    # Deterministic shell for the bash tool. pi resolves /bin/bash →
    # `bash` on PATH → spawn("sh") (the "spawn sh ENOENT" tool failure
    # captured live 2026-10-27), and NixOS has no /bin/bash. The unit
    # PATH does carry bashInteractive (which also ships `sh`), but the
    # probe chain runs per session and fails soft to `sh`; the pinned
    # store path is checked once and fails LOUD ("Custom shell path not
    # found") if the closure ever breaks.
    shellPath = "${pkgs.bashInteractive}/bin/bash";
  };

  modelsJson = pkgs.writers.writeJSON "models.json" {
    "$schema" = "https://pi.dev/schemas/models.schema.json";
    providers = {
      # Replaces pi's built-in `zai` (coding-plan baseUrl) with the plain
      # API endpoint the aichat client on this fleet already uses
      # (modules/ai.nix) — same key, same models. ${ZAI_API_KEY} is
      # interpolated at request time, never persisted.
      zai = {
        baseUrl = "https://api.z.ai/api/paas/v4";
        api = "openai-completions";
        apiKey = "\${ZAI_API_KEY}";
        models = [
          { id = "glm-5.3"; }
          { id = "glm-5.3-flash"; }
        ];
      };
    };
  };

  # Bot account + token provisioning. Runs as root: it calls the synapse
  # registration wrapper (reads the root-only registration shared secret
  # via its baked -c flags) and writes into /var/lib/matrix-secrets.
  setupScript = pkgs.writeShellScript "ai-matrix-bridge-setup" ''
    set -eu
    hs=${cfg.homeserverUrl}
    pw_file=${passwordFile}
    env_file=${tokenEnvFile}

    # A token that still authenticates means the bot device (and its E2EE
    # identity) is alive — minting another would force re-verification.
    if [ -s "$env_file" ]; then
      tok=$(${lib.getExe' pkgs.gnused "sed"} -n 's/^PI_MATRIX_BRIDGE_ACCESS_TOKEN=//p' "$env_file")
      if [ -n "$tok" ] && ${lib.getExe pkgs.curl} -fsS --max-time 10 \
          -H "Authorization: Bearer $tok" "$hs/_matrix/client/v3/account/whoami" -o /dev/null; then
        echo "pi bridge token still valid — nothing to do"
        exit 0
      fi
    fi

    if [ ! -s "$pw_file" ]; then
      ${lib.getExe' pkgs.openssl "openssl"} rand -hex 24 > "$pw_file"
    fi
    pw=$(cat "$pw_file")

    # Reruns against an existing account fail with "user already exists";
    # the login below is the actual gate, so tolerate it (watchdog idiom —
    # the wrapper carries the shared-secret config and the server URL).
    matrix-synapse-register_new_matrix_user -u ${cfg.botLocalpart} -p "$pw" -a || true

    echo "minting dedicated access token (device pi-matrix-bridge)"
    body=$(${lib.getExe pkgs.jq} -nc --arg u ${cfg.botLocalpart} --arg p "$pw" \
      '{type:"m.login.password",
        identifier:{type:"m.id.user",user:$u},
        password:$p,
        initial_device_display_name:"pi-matrix-bridge"}')
    # One login, one device: every extra /login here would mint an orphan
    # device the E2EE story then has to account for.
    resp=$(${lib.getExe pkgs.curl} -fsS --max-time 30 -X POST \
      -H 'Content-Type: application/json' -d "$body" \
      "$hs/_matrix/client/v3/login") || {
      echo "ERROR: Matrix login failed; Synapse up yet?" >&2
      exit 1
    }
    tok=$(printf '%s' "$resp" | ${lib.getExe pkgs.jq} -r '.access_token // empty')
    if [ -z "$tok" ]; then
      echo "ERROR: no access_token in login response: $resp" >&2
      exit 1
    fi
    printf 'PI_MATRIX_BRIDGE_ACCESS_TOKEN=%s\n' "$tok" > "$env_file"
    chmod 0600 "$pw_file" "$env_file"
    echo "pi bridge ready: @${cfg.botLocalpart}:${mstack.serverName}"
  '';
in
{
  options.services.aiMatrixBridge = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Always-on pi coding agent bridged to Matrix DMs on this host
        (headless pi + the pi-matrix-bridge extension). Flip off to stop
        the bot without touching the rest of the ai stack.
      '';
    };

    botLocalpart = lib.mkOption {
      type = lib.types.str;
      default = "pi";
      description = "Localpart of the bot account on the local homeserver.";
    };

    homeserverUrl = lib.mkOption {
      type = lib.types.str;
      default = "http://${mstack.listenAddress}:${toString mstack.listenPort}";
      defaultText = lib.literalExpression ''
        "http://''${config.services.matrixStack.listenAddress}:''${toString config.services.matrixStack.listenPort}"
      '';
      description = "Client-API URL of the homeserver the bridge logs into.";
    };

    model = lib.mkOption {
      type = lib.types.str;
      default = "glm-5.3";
      description = ''
        Startup model ID (one of the models in the models.json this module
        writes; glm-5.3-flash is the cheaper sibling).
      '';
    };

    environment = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = { };
      description = "Extra environment for the bridge service (e.g. PI_MATRIX_BRIDGE_SPACE_ID).";
    };

    trustedUsers = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ "matrix:@wyli:matrix.wyli.tech" ];
      description = ''
        Matrix users trusted to command the bot without the 6-digit
        challenge (transport-namespaced mxids). Seeded into
        .pi/matrix-bridge.json only when that file is absent — the
        challenge-auth extension rewrites it at runtime (revokes, new
        trusts) and must not be clobbered by deploys.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = mstack.enable;
        message = "services.aiMatrixBridge needs the local Synapse (services.matrixStack.enable).";
      }
      {
        assertion = pkgs.stdenv.hostPlatform.system == "x86_64-linux";
        message = ''
          pi-matrix-bridge E2EE: only the x86_64-linux napi prebuilt of
          matrix-sdk-crypto-nodejs is pinned. Add the matching artifact +
          hash for other platforms before importing there.
        '';
      }
    ];

    # Fixed uid for the same reason as the bridges (modules/matrix):
    # restic restores numeric ownership, so a re-install must not reshuffle.
    users.users.${user} = {
      isSystemUser = true;
      uid = lib.mkDefault 3005;
      inherit group;
      home = stateDir;
      # util-linux `script` (the PTY wrapper in ExecStart) spawns the login
      # shell; nologin makes it die with "This account is currently not
      # available". No password + key-only sshd = shell is safe here.
      shell = "${pkgs.bash}/bin/bash";
    };
    # systemd chdirs before ExecStartPre can mkdir — the workspace must
    # pre-exist via tmpfiles or the unit dies with 200/CHDIR on first boot.
    systemd.tmpfiles.rules = [
      "d ${workspaceDir} 0700 ${user} ${group} -"
    ];
    users.groups.${group} = { };

    # --- provisioning (oneshot, root — alert-bot idiom) ------------------
    systemd.services.ai-matrix-bridge-setup = {
      description = "pi Matrix bridge: register the bot and mint its access token";
      wantedBy = [ "multi-user.target" ];
      wants = [ "matrix-synapse.service" ];
      after = [ "matrix-secrets.service" "matrix-synapse.service" ];
      before = [ "ai-matrix-bridge.service" ];
      # A cold-starting Synapse can take minutes before it accepts
      # registrations, so retry indefinitely 30s apart.
      unitConfig.StartLimitIntervalSec = 0;
      # Never part of a switch transaction (see matrix-alert-bot): reruns
      # are moot — account, password and token persist in matrix-secrets.
      restartIfChanged = false;
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        Restart = "on-failure";
        RestartSec = "30s";
        UMask = "0077";
      };
      # writeShellScript yields a file at the store root — getExe' would build
      # <path>/bin/<name> and die with "Not a directory".
      script = toString setupScript;
      # synapse registration wrapper + bare -a flag (synapse 1.156: --no-admin
      # prompts for admin under systemd and EOFs without it)
      path = [ "/run/current-system/sw" ];
    };

    # --- the bridge -------------------------------------------------------
    systemd.services.ai-matrix-bridge = {
      description = "pi coding agent, bridged to Matrix DMs";
      wantedBy = [ "multi-user.target" ];
      # synapse ordering is load-bearing: without it a joint restart races —
      # the transport's first connect hits a still-down synapse (ECONNREFUSED)
      # and the extension never retries, leaving the bot deaf until bounced.
      wants = [ "network-online.target" "ai-matrix-bridge-setup.service" "matrix-synapse.service" ];
      after = [ "network-online.target" "ai-matrix-bridge-setup.service" "matrix-synapse.service" ];
      restartTriggers = [
        bridgeExtension
        settingsJson
        modelsJson
      ];
      preStart = ''
        set -eu
        install -d -m 0700 ${workspaceDir}
        # Agent config, fresh every start: the extension's store path
        # moves with each rebuild (see header). User data in the dir —
        # sessions/, mcp.json, skills/ — is never touched.
        install -m 0600 ${settingsJson} ${stateDir}/settings.json
        install -m 0600 ${modelsJson} ${stateDir}/models.json
        # Seed trust only when the auth file is absent — the extension
        # rewrites it at runtime and deploys must not clobber that state.
        if [ ! -f ${stateDir}/.pi/matrix-bridge.json ]; then
          install -D -m 0600 /dev/null ${stateDir}/.pi/matrix-bridge.json
          printf '%s\n' '${builtins.toJSON { auth.trustedUsers = cfg.trustedUsers; }}' > ${stateDir}/.pi/matrix-bridge.json
        fi
      '';
      environment = {
        HOME = stateDir;
        PI_CODING_AGENT_DIR = stateDir;
        PI_MATRIX_BRIDGE_AUTO_CONNECT = "1";
        PI_MATRIX_BRIDGE_HOMESERVER = cfg.homeserverUrl;
        # `/new <title>` rooms become children of this space (empty = off).
        # Override at the host level with the pi space's room id once it
        # exists; the bot needs state-event power in the space.
        PI_MATRIX_BRIDGE_SPACE_ID = lib.mkDefault "";
        # Live room-topic status line (🤖 model · ctx · cwd). Set 0 on a host
        # to disable; rooms where the bot can't set m.room.topic (needs PL 50,
        # e.g. someone else's untrusted private room) are skipped anyway.
        PI_MATRIX_BRIDGE_TOPIC = lib.mkDefault "1";
      } // cfg.environment;
      # pi's bash tool spawns whatever is on PATH — the systemd default PATH
      # has no bash/git, so every tool call failed and the model computed
      # answers "mentally" (observed live 2026-10-27). python3: the model
      # reached for `python3 -c` on its own in the DM within the first hour
      # (journal 2026-10-27), and NixOS coreutils-only PATHs don't have it.
      path = with pkgs; [
        bashInteractive
        git
        gnugrep
        gnused
        findutils
        curl
        jq
        procps
        python3
      ];
      serviceConfig = {
        Type = "simple";
        User = user;
        Group = group;
        StateDirectory = "pi-matrix-bridge";
        StateDirectoryMode = "0700";
        WorkingDirectory = workspaceDir;
        # /etc/nix/ai-env (KEY=VALUE, root:wheel 0640) carries ZAI_API_KEY;
        # pi-bridge.env the access token. systemd (PID 1) reads both as
        # root before dropping privileges.
        EnvironmentFile = [ "/etc/nix/ai-env" tokenEnvFile ];
        # PTY wrap (see module header); -e propagates pi's exit code.
        ExecStart = "${lib.getExe' pkgs.util-linux "script"} -qfec ${lib.getExe pkgs.pi-coding-agent} /dev/null";
        UMask = "0077";
        LockPersonality = true;
        NoNewPrivileges = true;
        PrivateTmp = true;
        # No PrivateDevices/PrivateUsers here on purpose: allocating the
        # PTY needs /dev/ptmx + a fresh devpts mount.
        ProtectClock = true;
        ProtectControlGroups = true;
        ProtectHome = true;
        ProtectHostname = true;
        ProtectKernelLogs = true;
        ProtectKernelModules = true;
        ProtectKernelTunables = true;
        ProtectSystem = "strict";
        ReadWritePaths = [ stateDir ];
        RestrictAddressFamilies = [ "AF_INET" "AF_INET6" "AF_UNIX" ];
        RestrictRealtime = true;
        RestrictSUIDSGID = true;
        SystemCallArchitectures = "native";
        SystemCallErrorNumber = "EPERM";
        SystemCallFilter = [ "@system-service" ];
        # MemoryDenyWriteExecute deliberately NOT set: V8's JIT needs
        # W+X pages, and the Rust crypto prebuilt is dlopen'ed on top
        # (same reason the mautrix units skip it for libolm).
        # `always`, not `on-failure`: `/shutdown` from a DM exits pi with
        # code 0 and the restart IS the fresh session (upstream recipe).
        Restart = "always";
        RestartSec = "5s";
        StartLimitIntervalSec = 0;
      };
    };
  };
}
