#!/usr/bin/env sh
# Enforce the fleet commit identity: wylited <44154103+wylited@users.noreply.github.com>.
# See AGENTS.md ("Git identity — hard rule"). The noreply address is the only
# one GitHub links to the wylited account, so anything else drops attribution.
#
# Note: git itself exports GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL to this hook with
# the identity it resolved from config, so those variables are always present
# on a real commit. We therefore reject a value only when it DIFFERS from the
# canonical pair; a user-supplied override is caught just the same because the
# override is what git exports.
set -eu

EXPECTED_NAME='wylited'
EXPECTED_EMAIL='44154103+wylited@users.noreply.github.com'
HINT='See AGENTS.md → "Git identity — hard rule".'

rc=0

fail() {
	echo "pre-commit: $1" >&2
	rc=1
}

check() {
	# check <label> <actual> <expected>
	if [ "$2" != "$3" ]; then
		fail "$1 is '$2', expected '$3'"
	fi
}

check 'git config user.name' "$(git config user.name || echo '<unset>')" "$EXPECTED_NAME"
check 'git config user.email' "$(git config user.email || echo '<unset>')" "$EXPECTED_EMAIL"
check 'GIT_AUTHOR_NAME' "${GIT_AUTHOR_NAME:-$EXPECTED_NAME}" "$EXPECTED_NAME"
check 'GIT_AUTHOR_EMAIL' "${GIT_AUTHOR_EMAIL:-$EXPECTED_EMAIL}" "$EXPECTED_EMAIL"
check 'GIT_COMMITTER_NAME' "${GIT_COMMITTER_NAME:-$EXPECTED_NAME}" "$EXPECTED_NAME"
check 'GIT_COMMITTER_EMAIL' "${GIT_COMMITTER_EMAIL:-$EXPECTED_EMAIL}" "$EXPECTED_EMAIL"

if [ "$rc" -ne 0 ]; then
	echo "pre-commit: refusing commit — commit as $EXPECTED_NAME <$EXPECTED_EMAIL>." >&2
	echo "pre-commit: $HINT" >&2
	exit 1
fi

exit 0
